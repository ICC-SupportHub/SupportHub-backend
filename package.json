{
  "name": "supporthub",
  "private": true,
  "scripts": {
    "dev:backend:win": "dotenv -e .env -- cmd /c \"cd backend && gradlew.bat bootRun\"",
    "dev:backend:unix": "dotenv -e .env -- sh -c 'cd backend && ./gradlew bootRun'",
    "dev:frontend": "npm -C frontend run dev",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend:win\" \"npm:dev:frontend\"",
    "dev:unix": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend:unix\" \"npm:dev:frontend\""
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "openai": "^6.8.1",
    "react-chartjs-2": "^5.3.0",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  }
}
